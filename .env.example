# Strava API app credentials (required)
# Create at: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Garmin Connect credentials
GARMIN_EMAIL=
# GARMIN_PASSWORD=  # Optional: will prompt interactively if not set

# Archive directory for downloaded FIT files (default: ./archive)
# ARCHIVE_DIR=./archive

# Strava session cookie for pull-strava (optional if using browser-cookie3)
# STRAVA_SESSION_COOKIE=

# Delay between Strava file downloads in seconds (default: 1.5)
# STRAVA_DOWNLOAD_DELAY=1.5

# Rate limit tunables — defaults match personal Strava app limits (200/15min, 2000/day)
# Each upload uses ~2 API calls (1 write + 1 read poll)
# STRAVA_RATE_LIMIT_15MIN=180
# STRAVA_RATE_LIMIT_DAILY=1800
